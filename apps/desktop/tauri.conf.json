{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fake Services",
  "version": "0.1.0",
  "identifier": "dev.fakeservices.app",
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "rpm"],
    "category": "DeveloperTool",
    "shortDescription": "Simulador local de servicios externos",
    "longDescription": "Fake Services simula APIs externas (endpoints, escenarios y webhooks) en tu equipo. Servicios falsos. Integraciones reales.",
    "publisher": "Fake Services",
    "copyright": "Fake Services contributors",
    "license": "MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "devel",
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
